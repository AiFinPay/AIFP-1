{
  "info": {
    "name": "AiFinPay AIFP-1 Merchant Monetization — Draft",
    "description": "Reference collection for AIFP-1 HTTP 402 merchant monetization. Current gross reference tiers: Standard $0.0005, Complex $0.002, Premium $0.005. Current AIFP-1 economics are gross-inclusive: payer settles gross, merchant receives 99%, AiFinPay receives 1% (treasury_bps=100), creator receives 0% (creator_bps=0). The 1% fee is not added on top. AIFP-2/x402 is a separate 0/0 route profile and is not represented by this collection. Endpoint availability depends on the active deployment; this collection is not evidence that every route is production-live.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "aifp-1-draft-collection",
    "version": "1.0.0-draft"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{api_key}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://api.aifinpay.io",
      "type": "string"
    },
    {
      "key": "api_key",
      "value": "REPLACE_ME",
      "type": "string"
    },
    {
      "key": "merchant_id",
      "value": "mrch_example",
      "type": "string"
    },
    {
      "key": "resource",
      "value": "/api/data",
      "type": "string"
    },
    {
      "key": "pricing_tier",
      "value": "standard",
      "type": "string"
    },
    {
      "key": "quote_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "tx_ref",
      "value": "0xREPLACE_WITH_PAYER_SETTLEMENT_TX",
      "type": "string"
    },
    {
      "key": "receipt_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1 — Create AIFP-1 Quote",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('quote response', () => pm.response.code === 200);",
              "if (pm.response.code === 200) {",
              "  const b = pm.response.json();",
              "  pm.collectionVariables.set('quote_id', b.quote_id);",
              "  pm.test('AIFP-1 route', () => b.route_class === 'AIFP-1');",
              "  pm.test('100/0 economics', () => Number(b.treasury_bps) === 100 && Number(b.creator_bps) === 0);",
              "  pm.test('payer total equals gross', () => b.payer_total_amount === b.gross_amount);",
              "  pm.test('creator amount is zero', () => Number(b.creator_amount) === 0);",
              "  pm.test('gross is conserved', () => {",
              "    const scale = 1000000000n;",
              "    const toScaled = (v) => BigInt(Math.round(Number(v) * Number(scale)));",
              "    return toScaled(b.merchant_amount) + toScaled(b.protocol_fee_amount) + toScaled(b.creator_amount) === toScaled(b.gross_amount);",
              "  });",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/quote",
          "host": ["{{base_url}}"],
          "path": ["v1", "quote"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"resource\": \"{{resource}}\",\n  \"pricing_tier\": \"{{pricing_tier}}\",\n  \"units\": 1\n}"
        },
        "description": "The service must fail before payment if no verifier-ready AIFP-1 settlement route is available. For the Standard preset, the gross payer amount is $0.0005 per action, the merchant amount is $0.000495, and the AiFinPay protocol fee is $0.000005. The fee is deducted from gross, not added on top."
      }
    },
    {
      "name": "2 — Submit Payer Settlement For Verification",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (!pm.request.headers.has('Idempotency-Key')) {",
              "  pm.request.headers.add({ key: 'Idempotency-Key', value: pm.variables.replaceIn('{{$guid}}') });",
              "}"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('verified, pending, or deterministic rejection', () => [200,202,409,410,422,503].includes(pm.response.code));",
              "if (pm.response.code === 200) {",
              "  const b = pm.response.json();",
              "  if (b.receipt_id) pm.collectionVariables.set('receipt_id', b.receipt_id);",
              "  if (b.gross_amount !== undefined) pm.test('receipt keeps 99/1/0 economics', () => Number(b.creator_amount) === 0 && Number(b.treasury_bps) === 100);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Idempotency-Key",
            "value": "{{$guid}}"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/pay",
          "host": ["{{base_url}}"],
          "path": ["v1", "pay"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quote_id\": \"{{quote_id}}\",\n  \"chain\": \"polygon\",\n  \"asset\": \"USDC\",\n  \"tx_ref\": \"{{tx_ref}}\"\n}"
        },
        "description": "The payer executes exactly the quoted gross settlement amount with its own wallet before this call. /v1/pay verifies the settlement reference and the gross-inclusive 99/1/0 split and must not issue a receipt on mismatch or verifier failure."
      }
    },
    {
      "name": "3 — Get Receipt",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/v1/receipt/{{receipt_id}}",
          "host": ["{{base_url}}"],
          "path": ["v1", "receipt", "{{receipt_id}}"]
        }
      }
    },
    {
      "name": "4 — Get Receipt Verification Keys",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "GET",
        "url": {
          "raw": "{{base_url}}/.well-known/jwks.json",
          "host": ["{{base_url}}"],
          "path": [".well-known", "jwks.json"]
        }
      }
    },
    {
      "name": "5 — Assisted Receipt Verification (Optional)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/v1/verify",
          "host": ["{{base_url}}"],
          "path": ["v1", "verify"]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"receipt\": \"<SIGNED_RECEIPT>\",\n  \"merchant_id\": \"{{merchant_id}}\",\n  \"resource\": \"{{resource}}\",\n  \"required_amount\": \"0.0005\"\n}"
        },
        "description": "required_amount is the required gross paid amount or quota-equivalent amount for the resource. Merchants should verify receipts locally where supported. This endpoint is an optional compatibility helper, not a substitute for settlement verification before receipt issuance."
      }
    }
  ]
}
